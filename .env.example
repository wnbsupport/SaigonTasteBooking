# Saigon Taste Booking – biến môi trường
# Trên SiteGround: nhập trong Site Tools → Devs → Node.js → (app) → Environment variables, rồi deploy lại.
# Chạy trên máy: copy file này thành .env (không có DB_NAME thì dùng SQLite trong file dev.sqlite).

# Địa chỉ app (dùng trong link email đặt lại mật khẩu, lời mời; bắt buộc https trên SiteGround)
APP_URL=https://booking.saigontaste.com.au

# Database MySQL tạo trong Site Tools → Site → MySQL
DB_HOST=localhost
DB_NAME=
DB_USER=
DB_PASSWORD=

# Tài khoản Chủ đầu tiên – chỉ dùng ở lần khởi động đầu. Đăng nhập được rồi thì XÓA ADMIN_PASSWORD.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Chủ Saigon Taste

# Khóa mã hóa mật khẩu hộp mail của các quán (chuỗi ngẫu nhiên, ít nhất 16 ký tự).
# KHÔNG đổi sau khi đã lưu mật khẩu mail, nếu đổi phải nhập lại mật khẩu mail của từng quán.
ENCRYPTION_KEY=

# Hộp mail hệ thống (SiteGround): gửi email đặt lại mật khẩu, mời nhân viên, cảnh báo đăng nhập, báo booking mới cho quán,
# và gửi thay khi hộp mail riêng của quán chưa cài hoặc bị lỗi. Máy chủ SMTP xem ở Site Tools → Email → Accounts → Mail Configuration.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_FROM_NAME=Saigon Taste Booking

# Giới hạn luồng xử lý cho shared hosting (tránh lỗi "Failed to fork" / 502). Giữ nguyên.
NODE_OPTIONS=--v8-pool-size=2
UV_THREADPOOL_SIZE=2

# Tùy chọn (mặc định đã đúng, thường không cần đặt)
# PORT=3000
# JOBS=1             # việc chạy nền: nhắc quán, hết hạn booking, gửi lại email lỗi
# DEPLOY_CLEANUP=1   # tự xóa bản deploy cũ trong public_html/.nodeapp
